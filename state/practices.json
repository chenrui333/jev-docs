      "first_seen": null,
      "first_seen_basis": "unknown_legacy",
      "historical_sources": [
        {
          "excerpt": "The state contains the content and supporting facts. Questions define the judgments the model should make about that material. For example, keep the refund request and policy in the state, then ask whether the customer requested a refund and whether the policy supports it.",
          "sha256": "0058f0fc9c583183912061fc57b583ec51a5fc354e0163d01b276d488e98a8d9",
          "source_id": "docs:concepts/state",
          "url": "https://docs.typesafe.ai/concepts/state.md"
        },
        {
          "excerpt": "Respond to changing state. Code can retain goals and observations while fresh judgments guide the next bounded step. Keep inferred state distinct from observed facts, and check freshness before applying a result to a changed situation.",
          "sha256": "71ea90d7906c6554c4f4c460ef7361b2d26f59116ccdae986dc6d997b9389f52",
          "source_id": "skill:typesafe-ai",
          "url": "https://raw.githubusercontent.com/typesafe-ai/skills/65a39f393687675ce170e6094757de20370365b9/skills/typesafe-ai/SKILL.md"
        },
        {
          "context_sha256": "577c72513fdaaec11fb5bd5cdbabb19fcc5cefc4664a8cc25307a1ef5853b289",
          "excerpt": "Keep inferred state distinct from observed facts, and check freshness before applying a result to a changed situation.",
          "sha256": "71ea90d7906c6554c4f4c460ef7361b2d26f59116ccdae986dc6d997b9389f52",
          "source_id": "skill:typesafe-ai",
          "url": "https://raw.githubusercontent.com/typesafe-ai/skills/65a39f393687675ce170e6094757de20370365b9/skills/typesafe-ai/SKILL.md"
        }
      ],
      "id": "observed-state-distinct-from-inference",
      "interpretation": "Repository interpretation supported by literal claims and manually reviewed complete source contexts; not an upstream quote.",
      "last_changed": "2026-10-21",
      "last_verified": "2026-10-18",
      "sources": [],
      "status": "unknown",
      "summary": "Keep observed application state and inferred model judgments conceptually distinct, and check freshness before applying a result to changed state."
    },
