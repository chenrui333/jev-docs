      ],
      "first_seen": null,
      "first_seen_basis": "unknown_legacy",
      "historical_sources": [
        {
          "excerpt": "A Noul value runs from 0 to 1, but it's not a scale of the thing you asked about. It is the probability that the answer is yes. If the question is really about degree, the value does not measure the degree. Below, \"Is the candidate strong in Python?\" is asked about four candidates, next to a Score with four levels: no experience, some familiarity, regular use in a job, deep expertise.",
          "sha256": "bf5d8c6700fbd9272ce27b53a6439d598e7915cdf505704ac7c827c6175ecb88",
          "source_id": "docs:primitives/noul",
          "url": "https://docs.typesafe.ai/primitives/noul.md"
        },
        {
          "context_sha256": "c4de48b07e555ea3effbb6f466d6ea848fec78cc7c419212531fbe1f6a87442f",
          "excerpt": "It is the probability that the answer is yes.",
          "sha256": "bf5d8c6700fbd9272ce27b53a6439d598e7915cdf505704ac7c827c6175ecb88",
          "source_id": "docs:primitives/noul",
          "url": "https://docs.typesafe.ai/primitives/noul.md"
        },
        {
          "context_sha256": "c4de48b07e555ea3effbb6f466d6ea848fec78cc7c419212531fbe1f6a87442f",
          "excerpt": "If the question is really about degree, the value does not measure the degree.",
          "sha256": "bf5d8c6700fbd9272ce27b53a6439d598e7915cdf505704ac7c827c6175ecb88",
          "source_id": "docs:primitives/noul",
          "url": "https://docs.typesafe.ai/primitives/noul.md"
        },
        {
          "context_sha256": "c4de48b07e555ea3effbb6f466d6ea848fec78cc7c419212531fbe1f6a87442f",
          "excerpt": "A value near 0.5 means the model gives yes and no similar probability.",
          "sha256": "bf5d8c6700fbd9272ce27b53a6439d598e7915cdf505704ac7c827c6175ecb88",
          "source_id": "docs:primitives/noul",
          "url": "https://docs.typesafe.ai/primitives/noul.md"
        }
      ],
      "id": "noul-is-yes-probability",
      "interpretation": "Repository interpretation supported by literal claims and manually reviewed complete source contexts; not an upstream quote.",
      "last_changed": "2026-10-21",
      "last_verified": "2026-10-18",
      "sources": [],
      "status": "unknown",
      "summary": "A Noul value is the probability that a yes/no proposition is true; a value near 0.5 means uncertainty between yes and no, not medium intensity."
    },
