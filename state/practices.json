        {
          "context_sha256": "7e8c7d3655b053ee29801b62c5b65550d85fb1294fdcc683a44466b0e19943d3",
          "sha256": "d1513cb2e0f72f58c11ac004ce99fd828fce8668a741b6a274247201e57db724",
          "source_id": "skill:typesafe-ai",
          "url": "https://raw.githubusercontent.com/typesafe-ai/skills/302eea662c54bca6730873fe245bec1d69ebc23d/skills/typesafe-ai/SKILL.md",
