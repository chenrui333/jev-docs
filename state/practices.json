      ],
      "first_seen": null,
      "first_seen_basis": "unknown_legacy",
      "historical_sources": [
        {
          "excerpt": "The correct threshold values depend on your domain and the performance of the model for your use case. Start with conservative thresholds, test with your own data, and adjust as you observe results.",
          "sha256": "5c325ec0c0b69e78129406ca7c5d3aef113bce365abd34985b8674cd278c81be",
          "source_id": "docs:confidence",
          "url": "https://docs.typesafe.ai/confidence.md"
        },
        {
          "context_sha256": "577c72513fdaaec11fb5bd5cdbabb19fcc5cefc4664a8cc25307a1ef5853b289",
          "excerpt": "Use probabilities and confidence to guide behavior, with thresholds evaluated on the user's data and consequences.",
          "sha256": "71ea90d7906c6554c4f4c460ef7361b2d26f59116ccdae986dc6d997b9389f52",
          "source_id": "skill:typesafe-ai",
          "url": "https://raw.githubusercontent.com/typesafe-ai/skills/65a39f393687675ce170e6094757de20370365b9/skills/typesafe-ai/SKILL.md"
        },
        {
          "context_sha256": "577c72513fdaaec11fb5bd5cdbabb19fcc5cefc4664a8cc25307a1ef5853b289",
          "excerpt": "System One models are trained for calibrated decisions; validate their performance in the target domain.",
          "sha256": "71ea90d7906c6554c4f4c460ef7361b2d26f59116ccdae986dc6d997b9389f52",
          "source_id": "skill:typesafe-ai",
          "url": "https://raw.githubusercontent.com/typesafe-ai/skills/65a39f393687675ce170e6094757de20370365b9/skills/typesafe-ai/SKILL.md"
        },
        {
          "context_sha256": "577c72513fdaaec11fb5bd5cdbabb19fcc5cefc4664a8cc25307a1ef5853b289",
          "excerpt": "Treat cookbook thresholds and demo results as examples to evaluate, not universal rules or permanent model limitations.",
          "sha256": "71ea90d7906c6554c4f4c460ef7361b2d26f59116ccdae986dc6d997b9389f52",
          "source_id": "skill:typesafe-ai",
          "url": "https://raw.githubusercontent.com/typesafe-ai/skills/65a39f393687675ce170e6094757de20370365b9/skills/typesafe-ai/SKILL.md"
        }
      ],
      "id": "domain-calibrated-thresholds",
      "interpretation": "Repository interpretation supported by literal claims and manually reviewed complete source contexts; not an upstream quote.",
      "last_changed": "2026-10-21",
      "last_verified": "2026-10-18",
      "sources": [],
      "status": "unknown",
      "summary": "Choose thresholds from the application's data, model performance, and consequences; do not treat cookbook thresholds as universal defaults."
    },
