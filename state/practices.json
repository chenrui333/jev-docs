      ],
      "first_seen": null,
      "first_seen_basis": "unknown_legacy",
      "historical_sources": [
        {
          "excerpt": "If you found TypeSafe while looking for a model to plug into your coding agent, start here. Jev is not a drop-in replacement for the LLM behind Claude Code, Cursor, opencode, Copilot, Muse Spark, Grok Bot, or similar tools. Instead, you can use your coding agent as usual to write code that uses Jev to make decisions.",
          "sha256": "72b81af8a34379d9c6d0f632aabc6b69b98dad6a85371ffd088687e844841a80",
          "source_id": "docs:introduction/coding-agents",
          "url": "https://docs.typesafe.ai/introduction/coding-agents.md"
        },
        {
          "context_sha256": "84ae8185b6d5087f55ceab82f8dca26f9616b1341214f6c69f78ca24a6e42386",
          "excerpt": "Instead, you can use your coding agent as usual to write code that uses Jev to make decisions.",
          "sha256": "72b81af8a34379d9c6d0f632aabc6b69b98dad6a85371ffd088687e844841a80",
          "source_id": "docs:introduction/coding-agents",
          "url": "https://docs.typesafe.ai/introduction/coding-agents.md"
        },
        {
          "context_sha256": "84ae8185b6d5087f55ceab82f8dca26f9616b1341214f6c69f78ca24a6e42386",
          "excerpt": "Jev is not a drop-in replacement for the LLM behind Claude Code, Cursor, opencode, Copilot, Muse Spark, Grok Bot, or similar tools.",
          "sha256": "72b81af8a34379d9c6d0f632aabc6b69b98dad6a85371ffd088687e844841a80",
          "source_id": "docs:introduction/coding-agents",
          "url": "https://docs.typesafe.ai/introduction/coding-agents.md"
        },
        {
          "context_sha256": "84ae8185b6d5087f55ceab82f8dca26f9616b1341214f6c69f78ca24a6e42386",
          "excerpt": "It does not generate text, write code, or hold a conversation.",
          "sha256": "72b81af8a34379d9c6d0f632aabc6b69b98dad6a85371ffd088687e844841a80",
          "source_id": "docs:introduction/coding-agents",
          "url": "https://docs.typesafe.ai/introduction/coding-agents.md"
        },
        {
          "context_sha256": "84ae8185b6d5087f55ceab82f8dca26f9616b1341214f6c69f78ca24a6e42386",
          "excerpt": "It takes a state and a set of typed questions and returns structured answers your code can use directly:",
          "sha256": "72b81af8a34379d9c6d0f632aabc6b69b98dad6a85371ffd088687e844841a80",
          "source_id": "docs:introduction/coding-agents",
          "url": "https://docs.typesafe.ai/introduction/coding-agents.md"
        },
        {
          "context_sha256": "84ae8185b6d5087f55ceab82f8dca26f9616b1341214f6c69f78ca24a6e42386",
          "excerpt": "Use Jev inside an app or agent you're building — for routing, classification, scoring, guardrails, or any structured decision",
          "sha256": "72b81af8a34379d9c6d0f632aabc6b69b98dad6a85371ffd088687e844841a80",
          "source_id": "docs:introduction/coding-agents",
          "url": "https://docs.typesafe.ai/introduction/coding-agents.md"
        }
      ],
      "id": "jev-complements-generative-agents",
      "interpretation": "Repository interpretation supported by literal claims and manually reviewed complete source contexts; not an upstream quote.",
      "last_changed": "2026-10-23",
      "last_verified": "2026-10-18",
      "sources": [],
      "status": "unknown",
      "summary": "Use coding agents to write software that calls Jev for bounded structured decisions such as routing, classification, scoring and guardrails. Jev does not replace their generative base model or write code or converse."
    },
