      "first_seen": null,
      "first_seen_basis": "unknown_legacy",
      "historical_sources": [
        {
          "excerpt": "The 0.5 confidence floor catches anything the model reports as genuinely uncertain. Above that, the threshold for acting without confirmation is higher for a destructive operation than for a read-only one. Your code encodes the risk tolerance.",
          "sha256": "5c325ec0c0b69e78129406ca7c5d3aef113bce365abd34985b8674cd278c81be",
          "source_id": "docs:confidence",
          "url": "https://docs.typesafe.ai/confidence.md"
        },
        {
          "context_sha256": "04d3afbc5bc6d3e581a38fd542a602b2385fa38f6de022c7e59c5e4f76e2ccec",
          "excerpt": "The 0.5 confidence floor catches anything the model reports as genuinely uncertain.",
          "sha256": "5c325ec0c0b69e78129406ca7c5d3aef113bce365abd34985b8674cd278c81be",
          "source_id": "docs:confidence",
          "url": "https://docs.typesafe.ai/confidence.md"
        },
        {
          "context_sha256": "04d3afbc5bc6d3e581a38fd542a602b2385fa38f6de022c7e59c5e4f76e2ccec",
          "excerpt": "Your code encodes the risk tolerance.",
          "sha256": "5c325ec0c0b69e78129406ca7c5d3aef113bce365abd34985b8674cd278c81be",
          "source_id": "docs:confidence",
          "url": "https://docs.typesafe.ai/confidence.md"
        },
        {
          "context_sha256": "04d3afbc5bc6d3e581a38fd542a602b2385fa38f6de022c7e59c5e4f76e2ccec",
          "excerpt": "Depending on context, you might ask the user to confirm, flag for review, or gather more information before acting.",
          "sha256": "5c325ec0c0b69e78129406ca7c5d3aef113bce365abd34985b8674cd278c81be",
          "source_id": "docs:confidence",
          "url": "https://docs.typesafe.ai/confidence.md"
        },
        {
          "context_sha256": "04d3afbc5bc6d3e581a38fd542a602b2385fa38f6de022c7e59c5e4f76e2ccec",
          "excerpt": "Route to a human, request clarification, or fall back to a different system.",
          "sha256": "5c325ec0c0b69e78129406ca7c5d3aef113bce365abd34985b8674cd278c81be",
          "source_id": "docs:confidence",
          "url": "https://docs.typesafe.ai/confidence.md"
        }
      ],
      "id": "confidence-is-not-permission",
      "interpretation": "Repository interpretation supported by literal claims and manually reviewed complete source contexts; not an upstream quote.",
      "last_changed": "2026-10-21",
      "last_verified": "2026-10-18",
      "sources": [],
      "status": "unknown",
      "summary": "Confidence is an uncertainty signal. Keep the permission to act, review, or escalate explicit in application code."
    },
    {
      "category": "primitives",
      "evidence_reviews": [
        {
          "context_sha256": "cb9128239597a8a1835857d32f4632fbdbc5a52e8c8e6a0cfdbf759443969810",
          "sha256": "d9e61d8eb02eabe327e49ca1079e8abbb5bd7635e0e443f4eb3e3a3e6af2f9bb",
