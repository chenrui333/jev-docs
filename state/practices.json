      ],
      "first_seen": null,
      "first_seen_basis": "unknown_legacy",
      "historical_sources": [
        {
          "excerpt": "Keep control flow, deterministic rules, and side effects in code.",
          "sha256": "9f5a20ac39383695d554bf812b365ed4b70622b8e5ac10484dce290469c68972",
          "source_id": "docs:concepts/how-to-build-with-system-one",
          "url": "https://docs.typesafe.ai/concepts/how-to-build-with-system-one.md"
        },
        {
          "context_sha256": "577c72513fdaaec11fb5bd5cdbabb19fcc5cefc4664a8cc25307a1ef5853b289",
          "excerpt": "Keep known rules, calculations, exact lookups, and execution in code.",
          "sha256": "71ea90d7906c6554c4f4c460ef7361b2d26f59116ccdae986dc6d997b9389f52",
          "source_id": "skill:typesafe-ai",
          "url": "https://raw.githubusercontent.com/typesafe-ai/skills/65a39f393687675ce170e6094757de20370365b9/skills/typesafe-ai/SKILL.md"
        },
        {
          "context_sha256": "577c72513fdaaec11fb5bd5cdbabb19fcc5cefc4664a8cc25307a1ef5853b289",
          "excerpt": "Preserve the user's chosen stack and scope; add TypeSafe where semantic understanding helps.",
          "sha256": "71ea90d7906c6554c4f4c460ef7361b2d26f59116ccdae986dc6d997b9389f52",
          "source_id": "skill:typesafe-ai",
          "url": "https://raw.githubusercontent.com/typesafe-ai/skills/65a39f393687675ce170e6094757de20370365b9/skills/typesafe-ai/SKILL.md"
        },
        {
          "context_sha256": "577c72513fdaaec11fb5bd5cdbabb19fcc5cefc4664a8cc25307a1ef5853b289",
          "excerpt": "Code owns the workflow; the model supplies programmable common sense where ordinary code needs semantic understanding.",
          "sha256": "71ea90d7906c6554c4f4c460ef7361b2d26f59116ccdae986dc6d997b9389f52",
          "source_id": "skill:typesafe-ai",
          "url": "https://raw.githubusercontent.com/typesafe-ai/skills/65a39f393687675ce170e6094757de20370365b9/skills/typesafe-ai/SKILL.md"
        }
      ],
      "id": "deterministic-before-jev",
      "interpretation": "Repository interpretation supported by literal claims and manually reviewed complete source contexts; not an upstream quote.",
      "last_changed": "2026-10-21",
      "last_verified": "2026-10-18",
      "sources": [],
      "status": "unknown",
      "summary": "Keep deterministic rules, calculations, exact lookups, control flow, and side effects in code; use Jev where semantic judgment is needed."
    },
