      "first_seen": null,
      "first_seen_basis": "unknown_legacy",
      "historical_sources": [
        {
          "excerpt": "Keep the needed answers available. Include a no-match outcome when nothing may fit; use a separate presence judgment when it is independently useful. For source-value selection, check candidate coverage: the model cannot choose an omitted value.",
          "sha256": "71ea90d7906c6554c4f4c460ef7361b2d26f59116ccdae986dc6d997b9389f52",
          "source_id": "skill:typesafe-ai",
